# Secret website configuration
# Copy this file to .env and fill in real values.

# Port the website listens on
PORT=3000

# Secret key used to sign session cookies (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=change-me

# Discord OAuth2 (https://discord.com/developers/applications -> OAuth2)
DISCORD_CLIENT_ID=your-client-id
DISCORD_CLIENT_SECRET=your-client-secret
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback

# Secret backend API used by the Status page (leave empty to show offline)
SECRET_API_URL=http://localhost:3551
SECRET_API_HEALTH_PATH=/status

# Discord invite shown around the site
DISCORD_INVITE=https://discord.gg/your-invite

# OAuth/token mock endpoints (leave unset in production)
#DISCORD_API_BASE=https://discord.com/api
